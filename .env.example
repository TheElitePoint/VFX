# Google Sheets (service-account access to the target sheet)
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Apify: active token, plus a comma-separated pool for automatic rotation
APIFY_TOKEN=
APIFY_TOKEN_POOL=

# Tavily: comma-separated API keys
TAVILY_API_KEYS=

# Optional: where local working data is written (git-ignored)
VFX_WORKDIR=./data
